<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A12"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/glow_circle"
                android:alpha="0.6" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">
                <ImageView
                    android:id="@+id/xLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/x_logo_vector" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StudioX"
                    android:textColor="#A78BFA"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Masuk"
            android:textColor="#F1F5F9"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat datang semula di StudioX!"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emel"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="20dp" />
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="nama@email.com"
            android:textColorHint="#475569"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kata Laluan"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="14dp" />
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="--------"
            android:textColorHint="#475569"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:inputType="textPassword"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa kata laluan?"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Log Masuk"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginTop="20dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atau"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="22dp" />
        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Log Masuk dengan Google"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:background="@drawable/input_bg"
            android:layout_marginTop="16dp" />
        <Button
            android:id="@+id/btnApple"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Log Masuk dengan Apple"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:background="@drawable/input_bg"
            android:layout_marginTop="10dp" />
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiada akaun? Daftar sekarang"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:padding="10dp" />
    </LinearLayout>
</ScrollView>
